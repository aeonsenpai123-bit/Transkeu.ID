# Salin jadi .env lalu isi di server/lokal saja. Jangan commit .env atau taruh kunci di frontend.
# Provider utama bawaan (baseline): gemini dengan gemini-2.5-flash.
# Pilihan LLM_PROVIDER: gemini, openai, anthropic.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Opsional untuk skrip pembanding model kandidat (npm run eval:models):
GEMINI_CANDIDATE_MODEL=gemini-2.5-pro

# Provider alternatif (pilih LLM_PROVIDER yang sesuai):
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Batas pertanyaan AI harian per IP (bawaan: 50)
BATAS_TANYA_HARIAN=50

# Upstash Redis untuk multi-instance production di Vercel (wajib untuk AI di production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SALT=

# Opsional: katalog artikel dan bukti lapangan PostgreSQL
DATABASE_URL=
