# Salin jadi .env lalu isi. Jangan commit .env.
# Kunci API Google Gemini (dapatkan gratis dari https://aistudio.google.com/)
GEMINI_API_KEY=
# Model bawaan: gemini-2.5-flash (bisa diganti gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash
# Batas pertanyaan AI per IP per hari (opsional)
BATAS_TANYA_HARIAN=50
