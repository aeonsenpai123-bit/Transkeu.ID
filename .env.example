# Salin jadi .env lalu isi. Jangan commit .env.
# Provider utama. Pilihan: openai, gemini, anthropic.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Provider alternatif (pilih LLM_PROVIDER yang sesuai):
# 1. Google Gemini (gratis di https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 2. Anthropic Claude (opsional jika menggunakan Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Batas pertanyaan AI harian per IP (bawaan: 50)
BATAS_TANYA_HARIAN=50

# Upstash Redis untuk multi-instance production di Vercel (opsional untuk lokal)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SALT=

# Opsional: katalog artikel dan bukti lapangan PostgreSQL
DATABASE_URL=
